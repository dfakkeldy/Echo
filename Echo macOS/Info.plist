<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts/</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MPEG-4 Movie</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>SubRip Subtitle</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.echo.audiobooks.srt</string>
			</array>
			<key>NSIsRelatedItemType</key>
			<true/>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video Chapter List</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>NSIsRelatedItemType</key>
			<true/>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.books</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Echo connects to user-provided, self-hosted Audiobookshelf servers (LAN,
		     Tailscale/CGNAT 100.64.0.0/10, VPN, reverse proxies) the developer does not
		     control. The connect UI defaults bare hosts to HTTPS and requires explicit
		     confirmation for plaintext HTTP credentials. NSAllowsLocalNetworking is
		     insufficient for confirmed HTTP servers because the Tailscale shared range is
		     not an ATS "local" range. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Echo remembers where you listen so you can revisit the context. Location is opt-in, reduced accuracy, on-device only, and deletable at any time.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Echo records short voice memos so you can attach narrated notes to your audiobook bookmarks.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Echo lets you dictate short text notes for audiobook bookmarks.</string>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>SubRip Subtitle</string>
			<key>UTTypeIdentifier</key>
			<string>com.echo.audiobooks.srt</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>srt</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-subrip</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
