# ── Echo: Audiobook Study Player Fastlane Configuration ────────────────────────

default_platform(:ios)

# ── Helpers ────────────────────────────────────────────────────────

require_relative "lib/echo_release_scheme"

# Returns true if the named *shared* scheme is committed in the project.
#
# Only shared schemes (Echo.xcodeproj/xcshareddata/xcschemes/) survive a fresh
# clone, so they are exactly the set CI can build — checking the file is both
# cheaper and more honest than shelling out to `xcodebuild -list`. The helper
# anchors the project path to its own file, so Fastlane's lane/action chdir
# behavior cannot change the result.
#
# History: this probe used to run `sh("xcodebuild -project 'Echo.xcodeproj'
# -list -json")`. Inside a Fastfile `sh` is FastFile#sh → Actions.sh_no_action,
# which does NOT chdir to the repo root, so xcodebuild looked for
# fastlane/Echo.xcodeproj, exited non-zero, `sh` raised, and the bare `rescue`
# swallowed it. The probe therefore returned false on EVERY run since it was
# written, the macOS archive below was never attempted, and the weekly guard
# that depends on it was dead code. Keep the rescue loud so the next silent
# failure shows up in the log.
def scheme_exists?(scheme_name)
  EchoReleaseScheme.scheme_exists?(scheme_name)
rescue => e
  UI.important("Scheme probe for '#{scheme_name}' failed: #{e.message}. Treating the scheme as absent.")
  false
end

def release_archive_xcargs(build_number)
  "CURRENT_PROJECT_VERSION=#{build_number} -jobs 5"
end

def github_warning(message)
  UI.important(message)
  puts("::warning::#{message}") if ENV["GITHUB_ACTIONS"] == "true"
  summary_path = ENV["GITHUB_STEP_SUMMARY"]
  return if summary_path.to_s.empty?

  File.open(summary_path, "a") do |file|
    file.puts("### Warning")
    file.puts(message)
    file.puts
  end
end

# The one-time bootstrap the macOS .pkg export depends on. Kept as a constant so
# the CI warning, the lane description, and ARCHITECTURE.md all say the same
# thing — a stale copy of this instruction is worse than none.
MAC_INSTALLER_CERT_REMEDIATION = <<~TEXT.freeze
  The Mac App Store ships a signed .pkg, and signing it needs the separate
  "Mac Installer Distribution" certificate ("3rd Party Mac Developer Installer"
  in Keychain Access). It is not in the match certificates repo, so CI cannot
  sign the installer.

  Fix it once, locally (Apple never re-issues a private key, so the certificate
  has to be imported with the key that created it):

      Scripts/import_mac_installer_cert.sh

  That stores certs/mac_installer_distribution/<id>.{cer,p12} in the match repo;
  every later CI run installs it automatically.
TEXT

# True when no Mac Installer Distribution identity is available to sign a .pkg.
#
# Tests the precondition directly rather than pattern-matching the failure text.
# Both disguises this bug wears carry no machine-readable cause — gym reports
# "Error packaging up the application" and match's readonly path reports "No code
# signing identity found", neither of which names the certificate — so matching
# on either string would be broad enough to mislabel unrelated failures.
#
# Only ever consulted from a rescue, i.e. after something has already failed, so
# the worst case is one extra hint on an already-red run. That matters because
# the check is not airtight: match imports into its own keychain on CI, and if
# that keychain is outside the default search list this reports "missing" even
# though the export had the identity. Do not promote this to a precondition
# check that gates the build.
def mac_installer_identity_missing?
  identities = `security find-identity -v 2>/dev/null`
  !identities.match?(/3rd Party Mac Developer Installer|Mac Installer Distribution/)
rescue StandardError => e
  UI.important("Could not inspect the keychain for a Mac Installer identity: #{e.message}")
  false
end

def fastlane_file_value(path)
  File.read(path).strip
rescue Errno::ENOENT
  ""
end

def required_fastlane_file_value(path, label)
  value = fastlane_file_value(path)
  return value unless value.empty?

  UI.user_error!("Missing #{label}. Fill fastlane/#{path} before submitting external TestFlight builds.")
end

def beta_app_review_info
  demo_user = fastlane_file_value("metadata/review_information/demo_user.txt")
  demo_password = fastlane_file_value("metadata/review_information/demo_password.txt")
  demo_account_required = !demo_user.empty? || !demo_password.empty?

  if demo_account_required && (demo_user.empty? || demo_password.empty?)
    UI.user_error!(
      "External TestFlight beta review needs both fastlane/metadata/review_information/demo_user.txt " \
      "and demo_password.txt, or neither when Echo does not require a demo login."
    )
  end

  info = {
    contact_email: required_fastlane_file_value("metadata/review_information/email_address.txt", "beta review contact email"),
    contact_first_name: required_fastlane_file_value("metadata/review_information/first_name.txt", "beta review contact first name"),
    contact_last_name: required_fastlane_file_value("metadata/review_information/last_name.txt", "beta review contact last name"),
    contact_phone: required_fastlane_file_value("metadata/review_information/phone_number.txt", "beta review contact phone number"),
    demo_account_required: demo_account_required,
    notes: required_fastlane_file_value("metadata/review_information/notes.txt", "beta review notes")
  }

  if demo_account_required
    info[:demo_account_name] = demo_user
    info[:demo_account_password] = demo_password
  end

  info
end

def testflight_distribution_options(group:, external:, review_info:)
  return { notify_external_testers: false } unless group && external

  {
    notify_external_testers: true,
    groups: [group],
    distribute_external: true,
    submit_beta_review: true,
    beta_app_review_info: review_info,
    demo_account_required: review_info[:demo_account_required]
  }
end

def screenshot_upload_files
  Dir.glob("screenshots/**/*.{png,jpg,jpeg}", File::FNM_CASEFOLD).select { |path| File.file?(path) }
end

def clear_snapshot_helper_cache!
  require "fileutils"
  helper_cache = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")
  FileUtils.rm_rf(helper_cache)
  UI.message("Cleared Fastlane snapshot helper cache: #{helper_cache}")
end

# ── Platforms & Lanes ──────────────────────────────────────────────

platform :ios do
  
  before_all do
    # Load the App Store Connect API key from your local git-ignored JSON file.
    # On CI, ensure these variables are mapped via env vars.
    #
    # Guarded so key-free lanes (screenshots, frame_app_store_screenshots) still run when
    # fastlane/api_key.json is absent. Lanes that talk to App Store Connect
    # (beta, upload_screenshots) check `@api_key` and fail with a clear message.
    require 'json'
    key_path = "api_key.json"
    if File.exist?(key_path)
      key_data = JSON.parse(File.read(key_path))
      @api_key = app_store_connect_api_key(
        key_id: key_data["key_id"],
        issuer_id: key_data["issuer_id"],
        key_content: key_data["key"],
        in_house: key_data["in_house"]
      )
    else
      @api_key = nil
      UI.important("No fastlane/api_key.json found — App Store Connect lanes are unavailable. Screenshot capture lanes work without it.")
    end
  end

  # Fails fast on lanes that require App Store Connect when no key is configured.
  def require_api_key!
    UI.user_error!(
      "This lane needs App Store Connect access. Create fastlane/api_key.json " \
      "(see fastlane/README.md / Appfile) and re-run."
    ) if @api_key.nil?
  end

  desc <<~DESC
    Archive and upload to TestFlight.

    This lane:
    1. Syncs code signing via match (appstore) for all bundle IDs
    2. Archives the iOS target (includes bundled watchOS app + widget)
    3. Archives the macOS target when the shared "Echo macOS" scheme exists,
       exporting a signed .pkg. Failures only warn — they never block iOS.
    4. Uploads the iOS .ipa to TestFlight, then the macOS .pkg in a second call
       (pilot takes ONE binary per call). Weekly sends both platforms to external
       testers; Nightly remains internal.

    Prerequisites:
    - fastlane match set up with a git repo and MATCH_PASSWORD
    - App Store Connect API key JSON at fastlane/api_key.json
    - For the macOS .pkg: the Mac Installer Distribution certificate must be in
      the match repo. It is a separate certificate from Apple Distribution and
      iOS never needs it. Seed it once with
      Scripts/import_mac_installer_cert.sh.
  DESC
  lane :beta do |options|
    require_api_key!

    # ── CI: non-interactive code-signing keychain ─────────────────────
    # Create a dedicated temporary keychain with its partition list set so
    # codesign can use the match-installed signing key WITHOUT a GUI prompt.
    # Without this, the archive's *signing* step hangs forever on a headless
    # runner waiting for a keychain-access dialog that no one can click (the
    # multi-hour stall at "Signing …appex"). No-op locally — local dev signs
    # against the login keychain. Must run BEFORE match so it installs there.
    setup_ci if is_ci

    # ── Release-train channel → TestFlight group routing ──────────────
    # release-trains.yml passes channel:nightly|weekly. Map each channel to its
    # tester group + distribution mode:
    #   nightly → "Nightly" (INTERNAL group: builds available instantly, no review)
    #   weekly  → "Weekly"  (EXTERNAL group: first build of a version needs Beta App Review)
    # Unknown/absent channel (e.g. a manual `fastlane beta`) → no group targeting.
    channel = (options[:channel] || ENV["RELEASE_CHANNEL"] || "").to_s.downcase
    tf_group, tf_external = case channel
                            when "nightly" then ["Nightly", false]
                            when "weekly"  then ["Weekly", true]
                            else [nil, false]
                            end
    UI.message("Release channel: #{channel.empty? ? '(none)' : channel} → group: #{tf_group || '(none)'}, external: #{tf_external}")

    review_info = beta_app_review_info if tf_group && tf_external
    distribution_options = testflight_distribution_options(
      group: tf_group,
      external: tf_external,
      review_info: review_info
    )

    # ── Nightly only: auto-draft "What to Test" from the commit delta ──────
    # Internal/nightly testers should always see fresh copy. Weekly/external
    # builds intentionally skip this and ship the human-curated committed file.
    # Fail-safe: the generator leaves the committed file untouched on empty
    # delta or any error, so this can never break a build.
    if channel == "nightly"
      UI.message("Nightly channel → regenerating testflight/what_to_test.txt from commit delta")
      sh(
        "cd .. && git fetch --no-tags --quiet origin weekly:refs/remotes/origin/weekly || true && " \
        "PYTHONPATH=Scripts python3 -m doc_automation.whats_new " \
        "--template fastlane/testflight/what_to_test.template.txt " \
        "--out fastlane/testflight/what_to_test.txt"
      )
    end

    # ── Build number (computed once; used by both iOS and macOS archives) ──
    # TestFlight requires each upload's build number (CFBundleVersion) to be
    # unique and higher than the previous. MARKETING_VERSION is left alone —
    # bump that only for real releases. Query TestFlight's latest build and add
    # one (starts at 1 when the app has no builds). Applied via xcargs so
    # CURRENT_PROJECT_VERSION is overridden without mutating the project.
    next_build = latest_testflight_build_number(
      api_key: @api_key,
      app_identifier: "com.echo.audiobooks",
      initial_build_number: 0
    ) + 1
    UI.message("Build number for this run: #{next_build}")

    # ── iOS: sync → (CI) manual-sign → archive ────────────────────────────
    # IMPORTANT: iOS is signed *and archived* fully BEFORE the macOS sync. The
    # macOS app is universal — it shares the iOS bundle id (com.echo.audiobooks)
    # under the `macos` platform — so its Mac App Store profile would overwrite
    # the iOS profile in match's bundle-id-keyed MATCH_PROVISIONING_PROFILE_MAPPING.
    # Building iOS first keeps the live mapping correct for the iOS archive/export.
    # (On CI the project's Automatic signing can't mint profiles headlessly, so we
    # switch each target to the match profile manually; local dev keeps Automatic.)
    sync_code_signing(
      api_key: @api_key,
      type: "appstore",
      app_identifier: [
        "com.echo.audiobooks",                   # main iOS app
        "com.echo.audiobooks.watchkitapp",         # bundled watchOS app
        "com.echo.audiobooks.watchkitapp.widget"   # widget extension
      ],
      readonly: is_ci
    )
    if is_ci
      mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
      {
        "Echo"                 => "com.echo.audiobooks",
        "Echo Watch App"       => "com.echo.audiobooks.watchkitapp",
        "Echo WidgetExtension" => "com.echo.audiobooks.watchkitapp.widget"
      }.each do |target, bundle_id|
        profile = mapping[bundle_id]
        next if profile.nil?
        update_code_signing_settings(
          path: "Echo.xcodeproj",
          use_automatic_signing: false,
          targets: [target],
          team_id: "8AXNA5B37R",
          code_sign_identity: "Apple Distribution",
          profile_name: profile
        )
      end
    end
    build_app(
      project: "Echo.xcodeproj",
      scheme: "Echo",
      export_method: "app-store",
      output_directory: "build",
      xcargs: release_archive_xcargs(next_build)
    )

    # ── macOS: sync → (CI) manual-sign → archive ──────────────────────────
    # Universal app: the Mac App Store profile is under the SAME bundle id
    # (com.echo.audiobooks) but the `macos` platform. Synced AFTER the iOS build
    # so it doesn't clobber the iOS profile mapping. Nightly may continue after a
    # visible warning; weekly/release lanes fail so Mac archive regressions cannot
    # silently ride the promotion train.
    #
    # Stays nil unless the macOS archive AND its .pkg export both succeed, which
    # is what gates the macOS TestFlight upload further down.
    macos_pkg_path = nil
    if scheme_exists?("Echo macOS")
      begin
        macos_signing = {
          api_key: @api_key,
          type: "appstore",
          platform: "macos",
          app_identifier: ["com.echo.audiobooks"],
          readonly: is_ci
        }
        # THE reason macOS packaging never once succeeded. A Mac App Store
        # submission needs TWO certificates, not one: "Apple Distribution"
        # signs the .app (shared with iOS), but the Mac App Store accepts an
        # *installer package*, and that .pkg must be signed by a separate
        # certificate type — "Mac Installer Distribution" (the keychain calls
        # it "3rd Party Mac Developer Installer"). iOS never needs it, so an
        # iOS-first match setup stores only Apple Distribution and every macOS
        # export died at the very last step with:
        #   error: exportArchive No signing certificate "Mac Installer Distribution" found
        # match only manages that cert when it is named here (match/options.rb
        # :additional_cert_types → runner.rb#fetch_certificate, which reads
        # certs/mac_installer_distribution/ in the certificates repo).
        #
        # Bootstrap is a ONE-TIME local step, because Apple never hands back a
        # private key: the cert must be imported into the match repo with the
        # key that created it. Run Scripts/import_mac_installer_cert.sh once.
        # Until then CI fails fast and loudly in the rescue below instead of
        # burning ~9 minutes archiving and dying on a generic export error.
        #
        # CI-ONLY, and that restriction is load-bearing — do not "simplify" it to
        # an unconditional option. This flag behaves in two completely different
        # ways depending on `readonly`:
        #   readonly: true  (CI)    → runner.rb globs certs/mac_installer_distribution/
        #                             in the match repo and imports the .cer/.p12
        #                             into the keychain. No portal call at all.
        #   readonly: false (local) → the same missing-cert branch goes to
        #                             Generator, which passes `force: true` to
        #                             cert (generator.rb:29), skipping the
        #                             reuse-an-existing-cert check and MINTING A
        #                             NEW installer certificate on every run.
        # Apple allows very few installer certificates per account, and each new
        # one orphans the previous. A developer running `fastlane beta` locally
        # does not need this option anyway: their own Mac Installer identity is
        # already in the login keychain, which is where gym looks.
        macos_signing[:additional_cert_types] = ["mac_installer_distribution"] if is_ci
        sync_code_signing(macos_signing)
        if is_ci
          macos_profile = (lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {})["com.echo.audiobooks"]
          unless macos_profile.nil?
            update_code_signing_settings(
              path: "Echo.xcodeproj",
              use_automatic_signing: false,
              targets: ["Echo macOS"],
              team_id: "8AXNA5B37R",
              code_sign_identity: "Apple Distribution",
              profile_name: macos_profile
            )
          end
        end
        build_app(
          project: "Echo.xcodeproj",
          scheme: "Echo macOS",
          export_method: "app-store",
          output_directory: "build",
          xcargs: release_archive_xcargs(next_build)
        )
        macos_pkg_path = lane_context[SharedValues::PKG_OUTPUT_PATH]
      rescue => e
        message = "macOS archive failed for #{channel.empty? ? 'manual' : channel} channel: #{e.message}"
        # Deliberately a warning on EVERY channel, weekly included.
        #
        # This block used to hard-fail (`UI.user_error!`) on weekly/release, but
        # that guard had never once executed: `scheme_exists?` was cwd-broken
        # (see the helper above), so the whole macOS path was dead code. Now that
        # the probe works, a hard fail here would abort the lane BEFORE
        # upload_to_testflight and take the iOS build down with it.
        #
        # Re-arm the weekly hard fail once a macOS .pkg has actually shipped from
        # CI at least once.
        #
        # Name the remediation instead of leaving a generic message. gym reports
        # a missing installer certificate as the useless "Error packaging up the
        # application", and match's readonly path reports it as a generic "cannot
        # create a new one" — both of which cost real debugging time to trace
        # back to one absent certificate. Detect both and say what to do.
        github_warning("#{message}. Continuing the iOS upload; fix the macOS target and re-run.")
        github_warning(MAC_INSTALLER_CERT_REMEDIATION) if mac_installer_identity_missing?
      end
    else
      UI.important("No shared 'Echo macOS' scheme found — skipping macOS build. Mark the scheme Shared in Xcode (Product ▸ Scheme ▸ Manage Schemes) and commit it to include the Mac archive.")
    end

    # ── Upload to TestFlight (iOS first, then macOS) ──────────────
    # pilot uploads exactly ONE binary per call: `ipa` and `pkg` are declared as
    # conflicting options. When the macOS archive above succeeds it leaves a
    # .pkg in lane_context, pilot picks the .ipa, logs a "both defined" warning,
    # and silently discards the .pkg. `app_platform` is pinned to "ios" below so
    # that choice is explicit instead of inferred from the ipa's Info.plist.
    # The Mac binary gets its own second call after this one.
    #
    # TestFlight copy lives in version-controlled files (paths relative to fastlane/):
    #   testflight/what_to_test.txt          → per-build "What to Test" (≤4000 chars)
    #   testflight/beta_app_description.txt  → Test Information description (≤4000 chars)
    #   metadata/review_information/*         → Beta App Review contact/demo info
    tf_options = {
      api_key: @api_key,
      # pilot needs a single bundle id; the Appfile's for_lane(:beta) sets
      # app_identifier to an ARRAY (for match), which upload_to_testflight rejects.
      app_identifier: "com.echo.audiobooks",
      # Explicit so the .ipa is chosen deterministically even when a macOS .pkg
      # is present, and so pilot never falls through to its interactive
      # "Please enter the app's platform" prompt on a headless runner.
      app_platform: "ios",
      skip_waiting_for_build_processing: false,
      changelog: File.read("testflight/what_to_test.txt"),
      beta_app_description: File.read("testflight/beta_app_description.txt"),
      # Where TestFlight's "Send Beta Feedback" emails land. Reuses the App Store
      # review contact for now; swap for a dedicated support address if one exists.
      beta_app_feedback_email: File.read("metadata/review_information/email_address.txt").strip
    }
    # Only external channels get groups and Beta App Review options. Internal
    # testers automatically receive every processed build, and assigning their
    # group explicitly makes pilot treat the upload as external distribution.
    tf_options.merge!(distribution_options)
    upload_to_testflight(tf_options)

    # ── Second upload: the macOS .pkg ─────────────────────────────────────
    # Until the Mac Installer Distribution certificate existed this could not
    # run, so the Mac app was archived every night and thrown away. Now that the
    # export produces a signed .pkg, ship it.
    #
    # Guarded on the path, not on `scheme_exists?`: pilot auto-fills BOTH :ipa
    # and :pkg from lane_context (upload_to_testflight.rb), so calling it with
    # app_platform "osx" and no .pkg does NOT fail cleanly — it reaches
    # PkgUploadPackageBuilder with a nil path and dies in File.size(nil).
    #
    # Weekly Mac builds use the same external group and Beta App Review options
    # as iOS. Nightly stays internal and receives processed builds automatically.
    if macos_pkg_path && File.exist?(macos_pkg_path)
      begin
        # The iOS .ipa is still in lane_context and pilot would log a confusing
        # "Both `ipa` and `pkg` options are defined". It picks the .pkg
        # regardless (build_manager.rb branches on app_platform == "osx"), but
        # this bug hid behind an ambiguous log once already — keep it readable.
        lane_context[SharedValues::IPA_OUTPUT_PATH] = nil

        macos_tf_options = {
          api_key: @api_key,
          app_identifier: "com.echo.audiobooks",
          pkg: macos_pkg_path,
          # "osx" is the only accepted macOS value — pilot's verify_block
          # rejects "macos". It is also the switch that makes pilot choose the
          # .pkg over the .ipa.
          app_platform: "osx",
          skip_waiting_for_build_processing: false,
          # BuildWatcher has no default timeout; without this a Mac build that
          # never appears in App Store Connect hangs the runner until the job's
          # 90-minute cap.
          wait_processing_timeout_duration: 1800,
          # Reuse the copy the iOS call already read rather than re-reading the
          # files, so the two platforms can never ship with different release
          # notes for the same commit.
          changelog: tf_options[:changelog],
          beta_app_description: tf_options[:beta_app_description],
          beta_app_feedback_email: tf_options[:beta_app_feedback_email]
        }
        macos_tf_options.merge!(distribution_options)
        upload_to_testflight(macos_tf_options)
      rescue => e
        # Same reasoning as the archive rescue: the iOS build has already
        # uploaded successfully by this point, and a macOS-side problem must not
        # retroactively fail the run that shipped it.
        github_warning("macOS .pkg upload failed: #{e.message}. The iOS build shipped normally.")
      end
    elsif scheme_exists?("Echo macOS")
      github_warning("No macOS .pkg was produced, so no Mac build was uploaded to TestFlight.")
    end

    # ── External only: open the group's public TestFlight link ────────────
    # Tester recruiting is link-driven: a public link lets anyone join the
    # Weekly group without an email invite (App Store Connect caps public-link
    # signups at 10,000). Enabling is idempotent and safe before the first
    # build clears Beta App Review — the link simply starts working once an
    # approved build is available. Fail-safe: recruiting plumbing must never
    # kill a train whose upload already succeeded, so every failure here
    # degrades to a warning. pilot has already logged Spaceship in with the
    # same key; the ||= is only a belt-and-braces fallback.
    if tf_group && tf_external
      begin
        Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.from(hash: @api_key)
        app = Spaceship::ConnectAPI::App.find("com.echo.audiobooks")
        group = app.get_beta_groups(filter: { name: tf_group }).first
        if group.nil?
          github_warning("TestFlight group '#{tf_group}' not found — public link not enabled.")
        else
          unless group.public_link_enabled
            group.update(attributes: {
              public_link_enabled: true,
              public_link_limit_enabled: true,
              public_link_limit: 10_000
            })
            group = app.get_beta_groups(filter: { name: tf_group }).first
          end
          UI.important("Public TestFlight link for #{tf_group}: #{group.public_link || '(pending — ASC shows it once a build is approved)'}")
        end
      rescue => e
        github_warning("Could not enable the #{tf_group} public TestFlight link: #{e.message}. Enable it manually in App Store Connect ▸ TestFlight ▸ #{tf_group}.")
      end
    end
  end

  lane :test_auth do
    require_api_key!
    # API key is already loaded in before_all, but we can verify it
    UI.success("API Key loaded successfully!")
  end

  desc <<~DESC
    Capture App Store screenshots on the simulator.

    Runs the EchoScreenshots UI test (EchoUITests target) via the
    "Echo Screenshots" scheme across the devices/languages in fastlane/Snapfile,
    writing PNGs to fastlane/screenshots/<locale>/.

    No App Store Connect key required.

    Prerequisites:
    - The app auto-seeds screenshot media in DEBUG simulator builds. This lane
      forces the bundled Standard Ebooks Great Gatsby EPUB fixture and Echo's
      internal Dark appearance setting, even if a local audio sample is present.
      See fastlane/screenshots/en-US/README_SCREENSHOTS.md.
    - Snapfile resolves current Xcode simulator names for the required sizes.

    Tip: stage the trickier shots by hand with Scripts/capture_screenshots.sh.
  DESC
  lane :screenshots do
    clear_snapshot_helper_cache!
    capture_screenshots
    UI.success("Screenshots written to fastlane/screenshots/. Review them, then run `fastlane upload_screenshots`.")
  end

  desc "Wrap the captured screenshots in device frames (requires `brew install imagemagick`)."
  lane :frame_app_store_screenshots do
    frameit(path: "./fastlane/screenshots")
  end

  desc <<~DESC
    Upload metadata to App Store Connect (no binary, no screenshots).

    Pushes fastlane/metadata/ to the app's current editable version. Requires
    fastlane/api_key.json. Use this when copy changes need to reconcile the ASC
    draft before final screenshots are ready.
  DESC
  lane :upload_metadata do
    require_api_key!
    upload_to_app_store(
      api_key: @api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true # skip the HTML preview/confirmation prompt
    )
  end

  desc <<~DESC
    Upload screenshots + metadata to App Store Connect (no binary).

    Pushes fastlane/screenshots/ and fastlane/metadata/ to the app's current
    editable version. Requires fastlane/api_key.json.
  DESC
  lane :upload_screenshots do
    require_api_key!
    upload_to_app_store(
      api_key: @api_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true # skip the HTML preview/confirmation prompt
    )
  end

  desc <<~DESC
    Upload screenshots + metadata only when reviewed screenshot files exist.

    Used by the weekly release train after TestFlight upload. If the screenshot
    folder only contains documentation, the lane logs a skip instead of blocking
    external TestFlight iteration.
  DESC
  lane :upload_screenshots_if_available do
    require_api_key!

    files = screenshot_upload_files
    if files.empty?
      UI.important("No PNG/JPG screenshots found under fastlane/screenshots; skipping App Store screenshot upload.")
    else
      UI.message("Uploading #{files.count} screenshot file(s) and metadata to App Store Connect.")
      upload_to_app_store(
        api_key: @api_key,
        skip_binary_upload: true,
        overwrite_screenshots: true,
        run_precheck_before_submit: false,
        force: true # skip the HTML preview/confirmation prompt
      )
    end
  end
end
